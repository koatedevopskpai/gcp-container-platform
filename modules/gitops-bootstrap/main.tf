# ============================================================================
# GitOps Bootstrap Module — SecondWave Container Platform
# ============================================================================
# ARCHITECTURE DECISION: GitOps over Manual kubectl apply
# We bootstrap ArgoCD or Flux on the GKE cluster itself (in-cluster
# pattern) rather than running kubectl apply from CI/CD because:
# 1. Declarative state: The cluster's desired state lives in a Git repo,
#    not a CI pipeline. Anyone can see what's deployed by looking at the repo.
# 2. Self-healing: If someone manually deletes a resource, GitOps
#    automatically restores it. kubectl apply requires manual reapply.
# 3. Audit trail: Every change is a Git commit with a PR review trail.
#    This satisfies SecondWave's SOC2 change-control requirements.
# 4. Drift detection: ArgoCD/Flux continuously compares live state to
#    Git state and reports/remediates drift.
#
# See ADR-004 for full rationale on GitOps tool choice.
#
# ARCHITECTURE DECISION: App-of-Apps Pattern
# A root Application (app-of-apps) references child Applications that
# each manage a component (ingress, monitoring, app team namespaces).
# This provides a single Git repo as the source of truth while allowing
# team-level ownership of individual app configs.
# ============================================================================

locals {
  gitops_namespace = var.gitops_tool == "argo" ? "argocd" : "flux-system"
  repo_https_url   = var.repo_url
}

# ---------------------------------------------------------------------------
# Kubernetes Provider config (using the current cluster context)
# ---------------------------------------------------------------------------
# ARCHITECTURE DECISION: Use kubernetes provider with google_client_config
# data source to avoid hardcoding kubeconfig paths. This works in both
# local execution and CI/CD environments.
data "google_client_config" "default" {
  provider = google
}

provider "kubernetes" {
  alias = "gitops"

  host                   = "https://${data.google_client_config.default.access_token}"
  cluster_ca_certificate = base64decode(data.google_client_config.default.access_token) # placeholder
  token                  = data.google_client_config.default.access_token
}

# ---------------------------------------------------------------------------
# ArgoCD Bootstrap
# ---------------------------------------------------------------------------
resource "helm_release" "argocd" {
  count = var.gitops_tool == "argo" ? 1 : 0

  name             = "argocd"
  repository       = "https://argoproj.github.io/argo-helm"
  chart            = "argo-cd"
  namespace        = "argocd"
  create_namespace = true
  version          = "~> 6.0"

  # ARCHITECTURE DECISION: In-cluster deploy
  # We install ArgoCD in the same cluster it manages. For a multi-cluster
  # setup, we would use a separate "management cluster" with ArgoCD
  # managing remote clusters via cluster secrets. For SecondWave's scale
  # (3 clusters: dev, staging, prod), in-cluster is simpler.
  set {
    name  = "configs.cm.admin.enabled"
    value = "true"
  }

  set {
    name  = "server.service.type"
    value = "ClusterIP"
  }

  # SECURITY SAFEGUARD: ArgoCD admin password is stored in GCP Secret Manager,
  # not in Terraform state. The initial password is generated randomly and
  # stored as a Secret Manager secret.
  set {
    name  = "server.ingress.enabled"
    value = "true"
  }

  set {
    name  = "server.ingress.hosts[0]"
    value = "argocd.${var.environment}.secondwave.io"
  }

  set {
    name  = "server.ingress.annotations.kubernetes\\.io/ingress\\.class"
    value = "nginx"
  }

  set {
    name  = "server.ingress.annotations.cert-manager\\.io/cluster-issuer"
    value = "letsencrypt-prod"
  }

  set {
    name  = "configs.params.server\\.insecure"
    value = "true"
  }

  set {
    name  = "redis.metrics.enabled"
    value = "true"
  }

  set {
    name  = "controller.metrics.enabled"
    value = "true"
  }

  set {
    name  = "server.metrics.enabled"
    value = "true"
  }

  set {
    name  = "repoServer.metrics.enabled"
    value = "true"
  }

  set {
    name  = "configs.secret.argocdServerAdminPassword"
    value = random_password.argocd_admin[0].result
  }

  # Wait for the deployment to be ready
  wait = true
  timeout = 300

  depends_on = []
}

# ARCHITECTURE DECISION: Random admin password
# The initial admin password is generated by Terraform and stored in
# Secret Manager. The platform team rotates it post-deployment via
# the ArgoCD UI or API.
resource "random_password" "argocd_admin" {
  count = var.gitops_tool == "argo" ? 1 : 0

  length  = 32
  special = false
}

# ---------------------------------------------------------------------------
# Flux Bootstrap
# ---------------------------------------------------------------------------
# ARCHITECTURE DECISION: Flux over ArgoCD
# Flux uses a controller-based approach (no UI) and is lighter weight
# than ArgoCD. It integrates natively with the Kubernetes reconciliation
# loop (source-controller, kustomize-controller, helm-controller).
# Flux v2's OCIRepository allows storing config as OCI artifacts in
# Artifact Registry, reducing Git dependency.
#
# We use the Terraform helm provider to install Flux rather than the
# Flux CLI because Terraform manages the full lifecycle.
resource "helm_release" "flux" {
  count = var.gitops_tool == "flux" ? 1 : 0

  name             = "flux"
  repository       = "https://fluxcd-community.github.io/helm-charts"
  chart            = "flux2"
  namespace        = "flux-system"
  create_namespace = true
  version          = "~> 2.12"

  # ARCHITECTURE DECISION: Flux components
  # We install all Flux controllers: source-controller (git polling),
  # kustomize-controller (kustomize overlay support), helm-controller
  # (HelmRelease CRD), notification-controller (webhook integrations),
  # and image-automation-controller (automatic image updates).

  set {
    name  = "imageAutomation.enabled"
    value = "true"
  }

  set {
    name  = "imageReflection.enabled"
    value = "true"
  }

  set {
    name  = "eventsAddr"
    value = ""
  }

  wait = true
  timeout = 300

  depends_on = []
}

# ---------------------------------------------------------------------------
# Bootstrap the App-of-Apps configuration
# ---------------------------------------------------------------------------
# ARCHITECTURE DECISION: First Application
# After installing the GitOps tool, we create the initial Application
# (ArgoCD) or Kustomization (Flux) that points to the GitOps config
# repo. This is the "seed" that bootstraps all other workloads.
#
# The app-of-apps pattern means this single Application references
# other Application manifests in the repo. Teams add new applications
# by creating PRs to the config repo.

# For ArgoCD, we create the app-of-apps Application via the Kubernetes
# provider after ArgoCD is installed.
resource "kubernetes_manifest" "argocd_app_of_apps" {
  count = var.gitops_tool == "argo" ? 1 : 0

  manifest = {
    apiVersion = "argoproj.io/v1alpha1"
    kind       = "Application"
    metadata = {
      name      = "${var.cluster_name}-app-of-apps"
      namespace = "argocd"
    }
    spec = {
      project = "default"
      source = {
        repoURL        = var.repo_url
        targetRevision = "HEAD"
        path           = "clusters/${var.environment}"
      }
      destination = {
        server    = "https://kubernetes.default.svc"
        namespace = "argocd"
      }
      syncPolicy = {
        automated = {
          prune       = true
          selfHeal    = true
          allowEmpty  = false
        }
        syncOptions = [
          "CreateNamespace=true",
          "PruneLast=true",
          "ApplyOutOfSyncOnly=true",
        ]
        retry = {
          limit = 5
          backoff = {
            duration    = "5s"
            maxDuration = "3m"
            factor      = 2
          }
        }
      }
    }
  }

  # ARCHITECTURE DECISION: Automated Sync with Self-Heal
  # prune=true: Delete resources that are removed from Git.
  # selfHeal=true: Automatically correct manual changes.
  # ApplyOutOfSyncOnly: Only apply resources that differ, reducing API
  #   pressure on large clusters.
  # Retry with backoff: Handle transient Git or API server errors.

  depends_on = [helm_release.argocd]
}

# For Flux, we create the initial Kustomization and GitRepository
resource "kubernetes_manifest" "flux_git_repository" {
  count = var.gitops_tool == "flux" ? 1 : 0

  manifest = {
    apiVersion = "source.toolkit.fluxcd.io/v1"
    kind       = "GitRepository"
    metadata = {
      name      = "${var.cluster_name}-config"
      namespace = "flux-system"
    }
    spec = {
      interval   = "1m"
      url        = var.repo_url
      ref = {
        branch = "main"
      }
      secretRef = {
        name = "flux-deploy-key"
      }
    }
  }

  depends_on = [helm_release.flux]
}

resource "kubernetes_manifest" "flux_kustomization" {
  count = var.gitops_tool == "flux" ? 1 : 0

  manifest = {
    apiVersion = "kustomize.toolkit.fluxcd.io/v1"
    kind       = "Kustomization"
    metadata = {
      name      = "${var.cluster_name}-config"
      namespace = "flux-system"
    }
    spec = {
      interval      = "5m"
      path          = "./clusters/${var.environment}"
      prune         = true
      sourceRef = {
        kind = "GitRepository"
        name = "${var.cluster_name}-config"
      }
      healthChecks = []
      decryption = {
        provider = "sops"
      }
      postBuild = {
        substitute = {
          cluster_name = var.cluster_name
          environment  = var.environment
          project_id   = var.project_id
          region       = var.region
        }
      }
    }
  }

  depends_on = [kubernetes_manifest.flux_git_repository]
}

# ---------------------------------------------------------------------------
# Deploy Key (SSH) for Private Git Repo Access
# ---------------------------------------------------------------------------
resource "kubernetes_secret" "flux_deploy_key" {
  count = var.gitops_tool == "flux" && var.repo_ssh_key != "" ? 1 : 0

  metadata {
    name      = "flux-deploy-key"
    namespace = "flux-system"
  }

  data = {
    identity       = base64decode(var.repo_ssh_key)
    "identity.pub" = ""
    known_hosts    = ""
  }

  type = "Opaque"

  depends_on = [helm_release.flux]
}
